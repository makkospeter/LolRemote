<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LolRemote</AssemblyName>
    <RootNamespace>LolRemote.Companion</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Product>LolRemote</Product>
    <Version>1.2.0</Version>
    <Description>LolRemote – League of Legends champ select a telefonodról</Description>
    <Company>makkospeter</Company>
    <Authors>makkospeter</Authors>
    <Copyright>Copyright © 2026 makkospeter</Copyright>
    <AssemblyTitle>LolRemote</AssemblyTitle>
    <NeutralLanguage>hu</NeutralLanguage>
    <RepositoryUrl>https://github.com/makkospeter/LolRemote</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2210.55" />
    <EmbeddedResource Include="wwwroot\**\*" LogicalName="wwwroot/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
